# ╔══════════════════════════════════════════════════════════════════════╗
# ║          YouTube Documentation Agent — Environment Config           ║
# ║                                                                      ║
# ║  Copy this file to .env and fill in your values:                     ║
# ║                                                                      ║
# ║  Required keys are marked with [REQUIRED].                           ║
# ║  All others have sensible defaults and are optional.                 ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────────────────────────────
# 1. LLM / AI PROVIDER KEYS
# ──────────────────────────────────────────────────────────────────────

# [REQUIRED] Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
# Used for: All LLM calls (section writing, chapter inference, description
#           parsing, relevance scoring, transcript cleanup, summaries)
GOOGLE_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────────────────────────────
# 2. EXTERNAL SERVICE TOKENS
# ──────────────────────────────────────────────────────────────────────

# [OPTIONAL] Notion Integration Token
# Get yours at: https://www.notion.so/my-integrations → New Integration
# Used for: Fetching Notion pages linked in video descriptions
# Leave empty if you don't need Notion document fetching
NOTION_TOKEN=NOTION_TOKEN

# [OPTIONAL] GitHub Personal Access Token (Classic)
# Get yours at: https://github.com/settings/tokens → Generate new token
# Scopes needed:
#   - [x] public_repo (Allows reading/fetching public repository contents & files)
#   - [x] gist        (Allows reading/fetching public and private Gists)
# Used for: Increases GitHub API rate limit from 60 to 5000 requests/hour
#           when fetching READMEs, files, and gists from video descriptions
# Leave empty to use unauthenticated access (60 req/hr limit)
GITHUB_TOKEN=GITHUB_TOKEN


# ──────────────────────────────────────────────────────────────────────
# 3. GOOGLE CLOUD / OAUTH (for Google Drive document fetching)
# ──────────────────────────────────────────────────────────────────────

# [OPTIONAL] Path to Google Drive OAuth credentials.json
# Get yours at: https://console.cloud.google.com/ → APIs & Services
#   → Credentials → Create Credentials → OAuth Client ID → Desktop App
#   → Download JSON → save as credentials.json
# Used for: Fetching Google Docs, Sheets, Slides, and Drive files
#           linked in video descriptions
GOOGLE_DRIVE_CREDENTIALS=data/credentials/credentials.json

# [OPTIONAL] Path where OAuth token is cached after first authentication
# Auto-generated after first successful Google Drive OAuth flow
GOOGLE_DRIVE_TOKEN_PATH=data/credentials/token.json

# ──────────────────────────────────────────────────────────────────────
# 4. LLM MODEL CONFIGURATION
# ──────────────────────────────────────────────────────────────────────

# Primary model for heavy tasks: section writing, relevance judging,
# chapter inference, summary generation, cross-reference writing
# Options: gemini-2.5-pro, gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
DEFAULT_MODEL=gemini-2.5-flash

# Lightweight model for quick tasks: description URL classification,
# transcript punctuation cleanup
FAST_MODEL=gemini-2.5-flash

# Temperature for structured/JSON output tasks (0.0 - 1.0)
# Lower = more deterministic, higher = more varied
TEMP_STRUCTURED=0.2

# Temperature for documentation writing tasks (0.0 - 1.0)
# Higher allows more natural, varied writing
TEMP_WRITING=0.7

# ──────────────────────────────────────────────────────────────────────
# 5. WHISPER / SPEECH-TO-TEXT CONFIGURATION
# ──────────────────────────────────────────────────────────────────────

# Faster-whisper model size for local STT (fallback when YouTube
# Transcript API is unavailable)
# Options: tiny (~75MB) | base (~150MB) | small (~500MB) |
#          medium (~1.5GB) | large (~3GB)
# Larger = more accurate but slower and uses more RAM
WHISPER_MODEL_SIZE=base

# Compute device for Whisper inference
# Options: cpu | cuda (requires NVIDIA GPU + CUDA toolkit)
WHISPER_DEVICE=cpu

# Quantization type for Whisper model
# Options: int8 (fastest, least memory) | float16 (GPU) | float32 (most precise)
WHISPER_COMPUTE_TYPE=int8

# ──────────────────────────────────────────────────────────────────────
# 6. PATHS & STORAGE
# ──────────────────────────────────────────────────────────────────────

# Path to the JSON cache index file (tracks processed videos)
CACHE_FILE=data/cache/index.json

# Directory where generated Markdown documentation files are saved
OUTPUTS_DIR=data/outputs

# Directory for log files (loguru)
LOG_DIR=data/logs

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────
# 7. RATE LIMITS & TUNING CONSTANTS
# ──────────────────────────────────────────────────────────────────────

# Max token count for transcript truncation before sending to LLM
MAX_TRANSCRIPT_TOKENS=12000

# Max characters to extract from each fetched document for relevance scoring
MAX_DOC_CONTENT_TOKENS=4000

# Maximum number of chapters to generate per video
MAX_CHAPTERS=20

# Minimum word count per generated documentation section
MIN_SECTION_WORDS=400

# Number of retries for failed LLM calls (uses exponential backoff)
MAX_RETRY_ATTEMPTS=3

# Base wait time (seconds) between LLM retry attempts
# Actual wait = RETRY_WAIT_SECONDS * (2 ^ attempt_number)
RETRY_WAIT_SECONDS=30

# Max characters to store from each fetched document
MAX_DOC_FETCH_CHARS=50000

# HTTP request timeout (seconds) for fetching documents (PDF, webpage, etc.)
REQUEST_TIMEOUT=30

# Timeout (seconds) for yt-dlp metadata/playlist subprocess calls
YTDLP_TIMEOUT=60

# Timeout (seconds) for yt-dlp audio download (Whisper fallback path)
WHISPER_DOWNLOAD_TIMEOUT=300
